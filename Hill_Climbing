
# Hill Climbing Algorithm

def objective(x):
    return -(x - 5) ** 2 + 25


def hill_climbing(start):

    current = start

    while True:

        # Generate neighboring states
        neighbors = [current - 1, current + 1]

        # Find the best neighbor
        best = max(neighbors, key=objective)

        # Check whether neighbor is better
        if objective(best) <= objective(current):
            break

        current = best

        print("Current State:", current)
        print("Current Value:", objective(current))

    return current


# Main program
start = 0

result = hill_climbing(start)

print("\nBest Solution:", result)
print("Maximum Value:", objective(result))
